@base = http://localhost:5000

### 1. Register (expect 201)
POST {{base}}/api/auth/register
Content-Type: application/json

{ "name": "Balram", "email": "user@test.com", "password": "Password123" }

### 2. Register again (expect 409)
POST {{base}}/api/auth/register
Content-Type: application/json

{ "name": "Balram", "email": "user@test.com", "password": "Password123" }

### 3. Bad input (expect 400 with a field list)
POST {{base}}/api/auth/register
Content-Type: application/json

{ "name": "B", "email": "nope", "password": "123" }

### 4. Wrong password (expect 401)
POST {{base}}/api/auth/login
Content-Type: application/json

{ "email": "user@test.com", "password": "WrongPass1" }

### 5. User login (expect 200 + token)
# @name loginUser
POST {{base}}/api/auth/login
Content-Type: application/json

{ "email": "user@test.com", "password": "Password123" }

### 6. Me (expect 200)
GET {{base}}/api/auth/me
Authorization: Bearer {{loginUser.response.body.$.token}}

### 7. USER hits admin route (expect 403)
GET {{base}}/api/admin/ping
Authorization: Bearer {{loginUser.response.body.$.token}}

### 8. No token (expect 401)
GET {{base}}/api/admin/ping

### 9. Admin login (expect 200 + token)
# @name loginAdmin
POST {{base}}/api/auth/login
Content-Type: application/json

{ "email": "admin@bookit.local", "password": "Admin@12345" }

### 10. ADMIN hits admin route (expect 200)
GET {{base}}/api/admin/ping
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### 11. Fixed-date slot (expect 201 the first time you send it)
# @name slot1
POST {{base}}/api/admin/slots
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{ "resource": "Court 1", "startTime": "2026-12-01T10:00:00.000Z", "endTime": "2026-12-01T11:00:00.000Z" }

### 12. Exact same body (expect 409)
POST {{base}}/api/admin/slots
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{ "resource": "Court 1", "startTime": "2026-12-01T10:00:00.000Z", "endTime": "2026-12-01T11:00:00.000Z" }

### 13. End before start (expect 400)
POST {{base}}/api/admin/slots
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{ "resource": "Court 1", "startTime": "{{$datetime iso8601 2 d}}", "endTime": "{{$datetime iso8601 1 d}}" }

### 14. Bulk with fixed dates (first time: created 8)
POST {{base}}/api/admin/slots/bulk
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{ "resource": "Court 2", "from": "2026-12-02T09:00:00.000Z", "to": "2026-12-02T13:00:00.000Z", "slotMinutes": 30 }

### 15. USER tries to create a slot (expect 403)
POST {{base}}/api/admin/slots
Authorization: Bearer {{loginUser.response.body.$.token}}
Content-Type: application/json

{ "resource": "Court 1", "startTime": "{{$datetime iso8601 3 d}}", "endTime": "{{$datetime iso8601 73 h}}" }

### 16. USER lists slots, page 1 (expect 200, no heldBy/bookedBy fields)
GET {{base}}/api/slots?limit=5&page=1
Authorization: Bearer {{loginUser.response.body.$.token}}

### 17. Filter by resource (expect only Court 2)
GET {{base}}/api/slots?resource=Court 2
Authorization: Bearer {{loginUser.response.body.$.token}}

### 18. Bad query (expect 400)
GET {{base}}/api/slots?limit=500
Authorization: Bearer {{loginUser.response.body.$.token}}

### 19. Delete the slot from #11 (expect 204)
DELETE {{base}}/api/admin/slots/{{slot1.response.body.$.slot._id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### 20. Delete it again (expect 404)
DELETE {{base}}/api/admin/slots/{{slot1.response.body.$.slot._id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### 21. Get a slot id
# @name slotList
GET {{base}}/api/slots?resource=Court 2&limit=1
Authorization: Bearer {{loginUser.response.body.$.token}}

### 22. Book it (expect 201)
POST {{base}}/api/bookings/naive
Authorization: Bearer {{loginUser.response.body.$.token}}
Content-Type: application/json

{ "slotId": "{{slotList.response.body.$.items[0]._id}}" }

### 23. Book the same slot again (expect 409; one at a time, naive code works)
POST {{base}}/api/bookings/naive
Authorization: Bearer {{loginUser.response.body.$.token}}
Content-Type: application/json

{ "slotId": "{{slotList.response.body.$.items[0]._id}}" }

### 24. Bad id (expect 400)
POST {{base}}/api/bookings/naive
Authorization: Bearer {{loginUser.response.body.$.token}}
Content-Type: application/json

{ "slotId": "abc" }

### 25. No token (expect 401)
POST {{base}}/api/bookings/naive
Content-Type: application/json

{ "slotId": "{{slotList.response.body.$.items[0]._id}}" }


### 26. Find an available slot
# @name freshSlot
GET {{base}}/api/slots?resource=Court 2&status=AVAILABLE&limit=1
Authorization: Bearer {{loginUser.response.body.$.token}}

### 27. Book it (expect 201)
POST {{base}}/api/bookings
Authorization: Bearer {{loginUser.response.body.$.token}}
Content-Type: application/json

{ "slotId": "{{freshSlot.response.body.$.items[0]._id}}" }

### 28. Book it again (expect 409)
POST {{base}}/api/bookings
Authorization: Bearer {{loginUser.response.body.$.token}}
Content-Type: application/json

{ "slotId": "{{freshSlot.response.body.$.items[0]._id}}" }

### 29. My bookings (expect 200, slot details included)
GET {{base}}/api/bookings/me
Authorization: Bearer {{loginUser.response.body.$.token}}